nt="1"><mxGeometry x="680" y="220" width="200" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Modelo → resultado&lt;/b&gt;&lt;br&gt;Corridas de MLflow (etapa 4)&lt;br&gt;&lt;br&gt;&lt;font color='#11735F'&gt;&lt;b&gt;implementado&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F1EC;strokeColor=#11735F;strokeWidth=1.4;align=left;verticalAlign=top;spacingTop=6;spacingLeft=14;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="900" y="220" width="200" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Métrica → definición&lt;/b&gt;&lt;br&gt;Metric view con dueño y descripción&lt;br&gt;&lt;br&gt;&lt;font color='#9A5B00'&gt;&lt;b&gt;propuesto&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7ECD9;strokeColor=#9A5B00;strokeWidth=1.4;dashed=1;dashPattern=5 4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="1120" y="220" width="200" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="4_Gobernanza_y_proyección" name="4 Gobernanza y proyección"><mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Gobernanza por dominios y proyección a futuro" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="20" y="-70" width="1000" height="34" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Dominio market-data · mesa de inversiones&lt;/b&gt;&lt;br&gt;&lt;br&gt;Precios, macro y FX, fundamentales, referencia, eventos.&lt;br&gt;Corrige alias, fechas y outliers antes de publicar.&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;prices_daily.v1 · macro_daily.v1 · fundamentals_quarterly.v1 · asset_reference_dim.v1 · market_events.v1&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15212C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="520" height="150" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Dominio clientele-data · banca y asesoría&lt;/b&gt;&lt;br&gt;&lt;br&gt;Perfil, horizonte, tolerancia y restricciones como números.&lt;br&gt;Dominio con datos personales en producción.&lt;br&gt;&lt;br&gt;&lt;font face='Courier New'&gt;client_profiles.v1&lt;/font&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15212C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="580" y="0" width="520" height="150" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Políticas federadas&lt;/b&gt; (cada dominio las aplica): ID canónico · ISO-8601 · UTF-8 · nulos declarados · moneda: riesgo en base, reporte en S/ con TC de cierre SBS" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F1EC;strokeColor=#11735F;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=14;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="20" y="180" width="1080" height="60" as="geometry"/></mxCell><mxCell id="c7" value="aplica" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#15212C;strokeWidth=1.6;fontSize=11;fontColor=#1F4F96;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="c4" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c8" value="aplica" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#15212C;strokeWidth=1.6;fontSize=11;fontColor=#1F4F96;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="&lt;b&gt;Calidad bloqueante&lt;/b&gt;&lt;br&gt;assert en silver" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15212C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="20" y="260" width="170" height="80" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;Restricciones Delta&lt;/b&gt;&lt;br&gt;ohlc_coherente · volumen ≥ 0" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15212C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="202" y="260" width="170" height="80" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;Cuarentena&lt;/b&gt;&lt;br&gt;con motivo, no se borra" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#15212C;strokeWidth=1.4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="384" y="260" width="170" height="80" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Permisos por rol&lt;/b&gt;&lt;br&gt;ingeniería · analistas · asesores" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7ECD9;strokeColor=#9A5B00;strokeWidth=1.4;dashed=1;dashPattern=5 4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="566" y="260" width="170" height="80" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Clasificación&lt;/b&gt;&lt;br&gt;etiquetas de datos personales" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7ECD9;strokeColor=#9A5B00;strokeWidth=1.4;dashed=1;dashPattern=5 4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="748" y="260" width="170" height="80" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Monitoreo de calidad&lt;/b&gt;&lt;br&gt;alertas de volumen y distribución" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7ECD9;strokeColor=#9A5B00;strokeWidth=1.4;dashed=1;dashPattern=5 4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="930" y="260" width="170" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;HOY · HACKATHON&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Medallón bronze → silver → gold&lt;br&gt;• EDA con % salvado por regla&lt;br&gt;• Cuarentena, dq_log, restricciones Delta&lt;br&gt;• Dashboard, simulador Monte Carlo, LSTM en MLflow" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F1EC;strokeColor=#11735F;strokeWidth=1.4;align=left;verticalAlign=top;spacingTop=8;spacingLeft=14;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="20" y="380" width="250" height="170" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;FASE 1 · INDUSTRIALIZAR&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Job orquestado desde el bundle&lt;br&gt;• Auto Loader incremental&lt;br&gt;• Pipeline declarativo con expectativas&lt;br&gt;• Alinear la réplica local con silver" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7ECD9;strokeColor=#9A5B00;strokeWidth=1.4;dashed=1;dashPattern=5 4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="295" y="380" width="250" height="170" as="geometry"/></mxCell><mxCell id="c17" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#15212C;strokeWidth=1.6;fontSize=11;fontColor=#1F4F96;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="&lt;b&gt;FASE 2 · GOBERNAR Y SERVIR&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Modelo estrella en gold&lt;br&gt;• Metric views y espacio Genie&lt;br&gt;• Permisos por rol y etiquetas&lt;br&gt;• Contratos de datos versionados" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7ECD9;strokeColor=#9A5B00;strokeWidth=1.4;dashed=1;dashPattern=5 4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="570" y="380" width="250" height="170" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#15212C;strokeWidth=1.6;fontSize=11;fontColor=#1F4F96;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c16" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;b&gt;FASE 3 · ESCALAR&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Perfiles desde el CRM; más clientes y monedas&lt;br&gt;• TC SBS y proveedor de mercado reales&lt;br&gt;• Recomendación al asesor y alerta de caída&lt;br&gt;• Compartir productos sin copiar datos" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F7ECD9;strokeColor=#9A5B00;strokeWidth=1.4;dashed=1;dashPattern=5 4;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fontColor=#15212C;" vertex="1" parent="1"><mxGeometry x="845" y="380" width="250" height="170" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#15212C;strokeWidth=1.6;fontSize=11;fontColor=#1F4F96;fontStyle=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="c18" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="Las fases son una secuencia propuesta, no un compromiso de fechas. Cada una se apoya en lo que ya funciona." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#56636F;" vertex="1" parent="1"><mxGeometry x="20" y="565" width="1100" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>